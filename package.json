{
  "name": "predictit",
  "private": true,
  "version": "0.1.0",
  "description": "Private SPX/SPY intraday options decision terminal (research + decision support + paper trading).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:engine": "pnpm --filter @predictit/engine test",
    "dev:web": "pnpm --filter @predictit/web dev",
    "dev:worker": "pnpm --filter @predictit/worker dev",
    "deploy": "pnpm --filter @predictit/web build && pnpm --filter @predictit/worker deploy",
    "research": "pnpm --filter @predictit/research run"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
